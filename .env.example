# .env LOCATION
#   Dev (uvicorn / pytest / CLI): project root. pydantic-settings reads
#     `.env` relative to the process CWD, so running from the repo root
#     picks up THIS file.
#   Server installs: `<LIBRARY_HOME>/.env` (default `~/LibraryData/.env`,
#     `C:\Users\<you>\LibraryData\.env` on Windows).
#   LLM keys are also editable from the Settings page at runtime; those
#     writes go to `<LIBRARY_HOME>/config_overlay.json` and override
#     this file. Use `.env` for infrastructure (DB_BACKEND, STORAGE_BACKEND,
#     LIBRARY_HOME itself) and bootstrap LLM keys.

# Single root for all on-disk state (db, library, objects, caches,
# config_overlay.json). Defaults to ~/LibraryData. Relocate the whole
# footprint by uncommenting and pointing this elsewhere — e.g. a big
# data disk. Per-component paths under it are not separately
# configurable; symlink subdirs if you want db on SSD and library on
# spinning rust.
# LIBRARY_HOME=

# Deployment identity exposed by GET /health. Release automation can set
# BUILD_SHA to the source revision and BUILD_ID to its build or rollout id.
APP_ENV=dev
BUILD_SHA=unknown
BUILD_ID=local

# DB backend: sqlite or postgres
DB_BACKEND=sqlite
POSTGRES_DSN=postgresql+asyncpg://library:library@localhost:5432/library
# PostgreSQL connection-pool sizing per API or worker process.
POSTGRES_POOL_SIZE=10
POSTGRES_MAX_OVERFLOW=20
POSTGRES_POOL_TIMEOUT_SECONDS=30
# Transaction-pooled PostgreSQL proxies require 0; direct connections keep 100.
POSTGRES_PREPARED_STATEMENT_CACHE_SIZE=100
# Keep true for local zero-setup startup. In managed deployments,
# run `library-db-prepare` first and set false to prevent replica startup DDL.
RUNTIME_SCHEMA_BOOTSTRAP_ENABLED=true

# Storage backend: mirror, local, or s3
#   mirror = folder-tree on disk matching the user's intent (default)
#   local  = UUID-flat object pool; faster, dedup-on, less human-friendly
#   s3     = remote object storage for multi-host deployments
# mirror/local always live under <LIBRARY_HOME>/{library,objects}.
# Relocate everything by setting LIBRARY_HOME, or symlink a single
# subdir if you want db on SSD and library on a big disk.
STORAGE_BACKEND=mirror

# S3 / MinIO settings (used when STORAGE_BACKEND=s3)
# Example: http://localhost:9000
S3_ENDPOINT_URL=
S3_BUCKET=library
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

# WebDAV knowledge-pack sync (optional)
# Publishes immutable metadata snapshots plus sha256-addressed blobs.
# This is not a live LIBRARY_HOME sync and does not upload sqlite/cache/runtime.
WEBDAV_URL=
WEBDAV_USERNAME=
WEBDAV_PASSWORD=
WEBDAV_REMOTE_PATH=/library
WEBDAV_AUTO_SYNC_ENABLED=false
WEBDAV_AUTO_SYNC_INTERVAL_MINUTES=60

# ===== API server =====
# The HTTP API has NO authentication unless a token is set. On the default
# loopback bind (127.0.0.1) that is fine. If you bind a non-loopback host or
# expose the API port on a LAN, set a token — otherwise every endpoint
# (uploads, deletes, settings including stored LLM keys) is fully open. The
# server logs a loud warning at startup when it binds non-loopback with no
# token.
# LIBRARY_API_TOKEN=
# LIBRARY_API_HOST=127.0.0.1
# LIBRARY_API_PORT=8000
# Browser origins allowed to read API responses (comma-separated). Empty uses
# the built-in default, the Vite dev server on 5173. Set this when serving the
# packaged frontend from another host or port, otherwise the browser blocks
# every API call. Not a security boundary: CORS restricts what other web pages
# may read, not what a direct client may request — use LIBRARY_API_TOKEN for
# access control.
# LIBRARY_CORS_ORIGINS=
# Per-dependency timeout for GET /ready.
# READINESS_TIMEOUT_SECONDS=2
#
# Max bytes accepted by POST /v1/upload. 0 (default) = unlimited, matching the
# local-first assumption. Set a cap when exposing the API beyond your own
# machine so a runaway or hostile client cannot fill the disk; oversized
# uploads are rejected with 413 before the body is spooled.
# LIBRARY_UPLOAD_MAX_BYTES=0

# Task worker
WORKER_ENABLED=true
WORKER_POLL_INTERVAL_SECONDS=2
WORKER_BATCH_SIZE=4
# Files matched and dispatched per transaction by a bulk reprocess task.
BULK_REPROCESS_PAGE_SIZE=500
WORKER_LEASE_SECONDS=60
WORKER_HEARTBEAT_SECONDS=20
# Initial retry delay for a failed delivery; later attempts use exponential backoff.
WORKER_RETRY_BASE_SECONDS=60
# Maximum delay between task attempts.
WORKER_RETRY_MAX_SECONDS=3600
# Disable only periodic scheduling while continuing to process ordinary queued tasks.
WORKER_SCHEDULER_ENABLED=true

# Automatic file lifecycle transitions. false keeps entries active unless
# the user manually changes lifecycle; true lets the worker demote/archive
# inactive entries on a schedule.
AUTO_LIFECYCLE_ENABLED=false
# Rolling 24-hour token cap for background maintenance LLM work. 0 disables
# the cap. Foreground ingest, chat, and reflection are unaffected.
MAINTENANCE_DAILY_TOKEN_BUDGET=0
# Allow background jobs to ask the model to vet mined entry relations.
RELATION_BACKGROUND_VETTING_ENABLED=false

# Retention pruning is bounded by both rows per batch and batches per run.
AUDIT_RETENTION_DAYS=90
TASK_RETENTION_DAYS=30
TASK_OUTCOME_RETENTION_DAYS=30
AGENT_EVENT_RETENTION_DAYS=30
PRUNE_BATCH_SIZE=1000
PRUNE_MAX_BATCHES=10

# Relation mining bounds reads and in-memory candidates independently of the
# much smaller number of relation rows written in one run.
RELATION_MINING_ENTRY_PAGE_SIZE=20000
RELATION_MINING_ACTIVITY_LIMIT=50000
RELATION_MINING_ELIGIBLE_TAG_LIMIT=20000
RELATION_MINING_CANDIDATE_LIMIT=100000

# Optional global deployment capacity gates. 0 disables each gate.
LIBRARY_DOCUMENT_LIMIT=0
LIBRARY_STORAGE_BYTES_LIMIT=0
INGEST_BACKLOG_LIMIT=0
CHAT_CONCURRENCY_LIMIT=0

# Default collision policy for uploads, renames, and moves: rename, error,
# or skip. Individual API requests can override this value.
DEFAULT_ON_CONFLICT=rename

# Pasted/dragged chat image limits. A zero count disables image attachments.
LIBRARY_CHAT_IMAGE_MAX_COUNT=4
LIBRARY_CHAT_IMAGE_MAX_BYTES=10485760
# auto uses the chat model when it supports images and otherwise uses the
# vision profile; on/off force or disable image understanding.
LIBRARY_CHAT_VISION=auto

# ===== Agent token budgets =====
# Per-call max_tokens for plan / execute phases. Defaults sized for
# gpt-4o-class models. Bump for long-context backends — e.g. DeepSeek-V3
# can return 64K+ in one shot, so 2048 will silently truncate answers.
# AGENT_PLAN_MAX_TOKENS=2048
# AGENT_EXECUTE_MAX_TOKENS=4096
# Maximum execute/tool rounds in one turn.
# AGENT_EXECUTE_MAX_TURNS=15
# Maximum tool calls from one model response that may run at once. Additional
# calls stay queued, which bounds database connections and memory use.
# AGENT_MAX_PARALLEL_TOOL_CALLS=8
# Server-side continuation and merged-output bounds for truncated final answers.
# AGENT_FINAL_ANSWER_CONTINUE_TURNS=3
# AGENT_FINAL_ANSWER_MAX_CHARS=120000
# Hard wall-clock limit for one foreground turn. 0 disables the timeout.
# AGENT_TURN_TIMEOUT_SECONDS=1800
# Prompt-cache SLO. Status is "insufficient_data" until this many eligible
# requests exist, then "met" or "breached" against the hit-ratio threshold.
# AGENT_CACHE_SLO_MIN_HIT_RATIO=0.95
# AGENT_CACHE_SLO_MIN_ELIGIBLE_REQUESTS=2

# Token-aware conversation compaction is separate from evidence compression.
# Stored turns remain lossless; only oversized provider request views are
# summarized. Reserve includes room for model output and request overhead.
# CONVERSATION_COMPACTION_ENABLED=true
# CONVERSATION_COMPACTION_RESERVE_TOKENS=8192

# Unified deterministic compression for large ingest, query, and read_files
# model views. Stored files and persisted tool results remain unchanged.
# COMPRESSION_ENABLED=true
# COMPRESSION_MIN_CHARS=12000
# COMPRESSION_TARGET_CHARS=8000
# COMPRESSION_CONTEXT_CHARS=220
# Keep compressed output only when it is smaller than this input ratio.
# COMPRESSION_MAX_RATIO=0.85

# Parallel LLM calls inside one ingest task. Applies to long text/PDF
# chunk indexing and scanned-PDF OCR pages. Raise for high-throughput
# providers; lower to 1-2 if you hit rate limits.
# Maximum output tokens for each ingest indexing call. Long extracted
# documents are split into sections instead of silently exceeding this cap.
# Set 0 to omit the limit for provider-managed OpenAI-compatible endpoints;
# Anthropic profiles require a positive value.
# LLM_INGEST_MAX_TOKENS=1200
# LLM_INGEST_CONCURRENCY=4

# ===== LLM defaults =====
# Per-profile overrides (LLM_<PROFILE>_*) inherit from LLM_DEFAULT_* per-field.
# PROVIDER:
#   openai            = OpenAI proper (supports strict json_schema)
#   openai-compatible = DeepSeek / Together / Groq / vllm / ollama. Same wire
#                       format; the adapter falls back to json_object + a
#                       schema-in-prompt instruction since these endpoints
#                       reject OpenAI's strict json_schema.
#   anthropic         = Anthropic Messages API
LLM_DEFAULT_PROVIDER=openai
LLM_DEFAULT_API_KEY=
LLM_DEFAULT_BASE_URL=
LLM_DEFAULT_MODEL=gpt-4o-mini
# Max provider calls per second for this provider/base/model. If several
# profiles resolve to the same model endpoint, the lowest matching TPS wins.
# LLM_DEFAULT_TPS=10
# Explicit model metadata. Dialect is never guessed from a gateway URL.
# Examples: openai, openai-compatible, anthropic, bailian, siliconflow,
# openrouter, together, nvidia, minimax, gemini, ollama, deepseek.
# LLM_DEFAULT_DIALECT=openai
# LLM_DEFAULT_CONTEXT_WINDOW=128000
# LLM_DEFAULT_TOKENIZER=o200k_base
# LLM_DEFAULT_SUPPORTS_VISION=true
# LLM_DEFAULT_SUPPORTS_TOOLS=true
# LLM_DEFAULT_SUPPORTS_TEMPERATURE=true
# Use max_completion_tokens only for endpoints that require the newer field.
# LLM_DEFAULT_TOKEN_LIMIT_PARAM=max_tokens

# ===== Backup (failover) model =====
# When the primary profile exhausts its transient-retry budget (rate limit /
# connection timeout / 5xx / Anthropic "Overloaded"), the chat pipeline
# switches to the backup endpoint ONCE. Only these four fields are needed —
# capabilities (dialect, context window, tokenizer, vision/tool support)
# inherit the primary. A blank model disables failover. Per-profile backups
# (LLM_<PROFILE>_BACKUP_*) inherit from the default's backup per-field, the
# same way the primary profiles inherit LLM_DEFAULT_*. The backup for a
# vision profile should be an explicitly-configured vision-capable model.
# LLM_DEFAULT_BACKUP_PROVIDER=
# LLM_DEFAULT_BACKUP_API_KEY=
# LLM_DEFAULT_BACKUP_BASE_URL=
# LLM_DEFAULT_BACKUP_MODEL=

# ===== Per-profile LLM overrides (optional) =====
# Profiles: chat, reflect, ingest, vision. Audio settings are reserved for the
# transcription adapter and are not exposed as an ingest pipeline yet.
# LLM_CHAT_PROVIDER=
# LLM_CHAT_API_KEY=
# LLM_CHAT_BASE_URL=
# LLM_CHAT_MODEL=
# LLM_CHAT_TPS=10
# LLM_CHAT_DIALECT=
# LLM_CHAT_CONTEXT_WINDOW=
# LLM_CHAT_TOKENIZER=
# LLM_CHAT_SUPPORTS_VISION=
# LLM_CHAT_SUPPORTS_TOOLS=
# LLM_CHAT_SUPPORTS_TEMPERATURE=
# LLM_CHAT_TOKEN_LIMIT_PARAM=
# LLM_CHAT_BACKUP_PROVIDER=
# LLM_CHAT_BACKUP_API_KEY=
# LLM_CHAT_BACKUP_BASE_URL=
# LLM_CHAT_BACKUP_MODEL=

# LLM_REFLECT_PROVIDER=
# LLM_REFLECT_API_KEY=
# LLM_REFLECT_BASE_URL=
# LLM_REFLECT_MODEL=
# LLM_REFLECT_TPS=10
# LLM_REFLECT_DIALECT=
# LLM_REFLECT_CONTEXT_WINDOW=
# LLM_REFLECT_TOKENIZER=
# LLM_REFLECT_SUPPORTS_VISION=
# LLM_REFLECT_SUPPORTS_TOOLS=
# LLM_REFLECT_SUPPORTS_TEMPERATURE=
# LLM_REFLECT_TOKEN_LIMIT_PARAM=
# LLM_REFLECT_BACKUP_PROVIDER=
# LLM_REFLECT_BACKUP_API_KEY=
# LLM_REFLECT_BACKUP_BASE_URL=
# LLM_REFLECT_BACKUP_MODEL=

# LLM_INGEST_PROVIDER=
# LLM_INGEST_API_KEY=
# LLM_INGEST_BASE_URL=
# LLM_INGEST_MODEL=
# LLM_INGEST_TPS=10
# LLM_INGEST_DIALECT=
# LLM_INGEST_CONTEXT_WINDOW=
# LLM_INGEST_TOKENIZER=
# LLM_INGEST_SUPPORTS_VISION=
# LLM_INGEST_SUPPORTS_TOOLS=
# LLM_INGEST_SUPPORTS_TEMPERATURE=
# LLM_INGEST_TOKEN_LIMIT_PARAM=
# LLM_INGEST_BACKUP_PROVIDER=
# LLM_INGEST_BACKUP_API_KEY=
# LLM_INGEST_BACKUP_BASE_URL=
# LLM_INGEST_BACKUP_MODEL=

# LLM_VISION_PROVIDER=
# LLM_VISION_API_KEY=
# LLM_VISION_BASE_URL=
# LLM_VISION_MODEL=
# LLM_VISION_TPS=10
# LLM_VISION_DIALECT=
# LLM_VISION_CONTEXT_WINDOW=
# LLM_VISION_TOKENIZER=
# The configured vision model must accept image inputs when document vision
# is enabled; startup rejects contradictory settings.
# LLM_VISION_SUPPORTS_VISION=true
# LLM_VISION_SUPPORTS_TOOLS=
# LLM_VISION_SUPPORTS_TEMPERATURE=
# LLM_VISION_TOKEN_LIMIT_PARAM=
# A vision backup must itself be a vision-capable model — capabilities are
# inherited from the vision profile, but only explicitly-configured values
# reach this raw endpoint.
# LLM_VISION_BACKUP_PROVIDER=
# LLM_VISION_BACKUP_API_KEY=
# LLM_VISION_BACKUP_BASE_URL=
# LLM_VISION_BACKUP_MODEL=

# LLM_AUDIO_PROVIDER=
# LLM_AUDIO_API_KEY=
# LLM_AUDIO_BASE_URL=
# LLM_AUDIO_MODEL=
# LLM_AUDIO_TPS=10

# Embedded images inside DOCX/PPTX can be described at ingest and queried
# with read_files(question=...). Disable or lower caps if VLM cost matters.
# DOCUMENT_VISION_ENABLED=true
# DOCUMENT_VISION_MAX_IMAGES=20
# DOCUMENT_VISION_QUESTION_MAX_IMAGES=5
# DOCUMENT_VISION_MIN_IMAGE_BYTES=2048
# DOCUMENT_VISION_MIN_IMAGE_DIMENSION=32
# DOCUMENT_VISION_MIN_IMAGE_AREA=4096

# Maximum pages OCR processes during ingest. 0 or a negative value removes
# the cap; deeper pages can still be read on demand when a cap is active.
# OCR_MAX_PAGES=300

# ===== Optional semantic recall =====
# Embedding credentials are separate from LLM_* profiles. They are never
# inferred from chat, vision, or ingest keys.
# EMBEDDING_PROVIDER=openai-compatible
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# EMBEDDING_MODEL=text-embedding-v4
# EMBEDDING_DIMENSIONS=1024
# EMBEDDING_TPS=10
# EMBEDDING_BATCH_SIZE=10
#
# Build an index with:
#   library eval build-semantic-index <dataset>
# Then enable semantic candidates in recall_knowledge:
# SEMANTIC_RECALL_ENABLED=false
# SEMANTIC_RECALL_LIMIT=100
# SEMANTIC_INDEX_BACKEND=auto       # auto, file, sqlite-vec
# Database rows loaded per page during a full semantic rebuild.
# SEMANTIC_REBUILD_PAGE_SIZE=100
# Minimum cosine score for attaching a best-section locator to lexical hits.
# SECTION_BACKFILL_MIN_SCORE=0.45
# Stable sections embedded per document. Lower this for high-throughput shared
# deployments; 0 keeps only the document-level vector.
# SECTION_EMBEDDING_MAX_SECTIONS=200

# ===== Optional rerank =====
# Rerank is a second-stage retrieval refinement over recalled candidates.
# It also uses its own credential; no LLM_* key is reused implicitly.
# RERANK_ENABLED=false
# RERANK_API_KEY=
# RERANK_BASE_URL=https://dashscope.aliyuncs.com/compatible-api/v1
# RERANK_MODEL=qwen3-rerank
# RERANK_TPS=10
# RERANK_BATCH_SIZE=100
# RERANK_TOP_N=80
# RERANK_MAX_DOC_CHARS=1800
# RERANK_CONCURRENCY=10
# EVIDENCE_SELECTION=quota          # quota or rerank
